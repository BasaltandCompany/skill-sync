{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "skill-sync desktop: read/write the user's agent configs and open the browser for sign-in",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$HOME" }
      ]
    }
  ]
}
